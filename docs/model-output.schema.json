{
  "$defs": {
    "ModelInfo": {
      "additionalProperties": false,
      "properties": {
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "label_version": {
          "minLength": 1,
          "title": "Label Version",
          "type": "string"
        },
        "preprocess_version": {
          "minLength": 1,
          "title": "Preprocess Version",
          "type": "string"
        },
        "label_ids": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 2,
          "title": "Label Ids",
          "type": "array"
        },
        "score_type": {
          "enum": [
            "probability",
            "decision_score"
          ],
          "title": "Score Type",
          "type": "string"
        },
        "calibrated": {
          "default": false,
          "title": "Calibrated",
          "type": "boolean"
        },
        "mode": {
          "default": "model",
          "enum": [
            "model",
            "demo"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "model_version",
        "label_version",
        "preprocess_version",
        "label_ids",
        "score_type"
      ],
      "title": "ModelInfo",
      "type": "object"
    },
    "ModelScore": {
      "additionalProperties": false,
      "properties": {
        "label_id": {
          "minimum": 0,
          "title": "Label Id",
          "type": "integer"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "label_id",
        "score"
      ],
      "title": "ModelScore",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "model_info": {
      "$ref": "#/$defs/ModelInfo"
    },
    "predictions": {
      "items": {
        "$ref": "#/$defs/ModelScore"
      },
      "minItems": 1,
      "title": "Predictions",
      "type": "array"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    },
    "input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Tokens"
    }
  },
  "required": [
    "model_info",
    "predictions"
  ],
  "title": "ModelOutput",
  "type": "object"
}
